# Server Configuration
PORT=3000
NODE_ENV=development

# Single canonical frontend URL used for building links in emails (not for CORS)
FRONTEND_URL=http://localhost:5173

# This backend's own public URL, used for building links to uploaded files
BACKEND_URL=http://localhost:3000

# Comma-separated list of allowed frontend origins for CORS (can include multiple, e.g. local + deployed)
CLIENT_URL=http://localhost:5173,https://your-deployed-frontend.vercel.app

# Database
# Replace with your MongoDB connection string
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# File Uploads
UPLOAD_DIR=uploads

# Email Configuration (for password reset, e.g., using Mailtrap)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=your_mail_username
MAIL_PASS=your_mail_password
